{[ const block = context /]}

<!-- START FOOTER -->
<div class="footer">
    <table border="0" cellpadding="0" cellspacing="0">
    {[ if block.properties.showDescription ]}
    <tr>
        <td class="content-block">
            <span>{{ block.properties.description }}</span>
            <br />
        </td>
    </tr>
    {[/]}
    <tr>
        <td class="content-block powered-by">
            {{ block.properties.copyright }}
        </td>
    </tr>
    </table>
</div>
<!-- END FOOTER -->